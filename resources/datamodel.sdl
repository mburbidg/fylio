scalar DateTime

type User {
  id: ID!
  firstName: String!
  lastName: String!
  dateOfBirth: DateTime!
  email: String!
}

input CreateUserInput {
  firstName: String!
  lastName: String!
  dateOfBirth: DateTime!  # ISO-8601 string, e.g. "1980-01-01T00:00:00Z"
  email: String!
  password: String!
}

type Query {
  user(id: ID!): User
  users: [User!]!
}

type Mutation {
  createUser(input: CreateUserInput!): ID!
}