{:paths ["src" "resources"]
 :deps  {org.clojure/clojure       {:mvn/version "1.12.0"}
         ring/ring-core            {:mvn/version "1.15.3"}
         ring/ring-jetty-adapter   {:mvn/version "1.15.3"}
         metosin/reitit-middleware {:mvn/version "0.10.0"}
         metosin/reitit-ring       {:mvn/version "0.10.0"}
         metosin/reitit-malli      {:mvn/version "0.10.0"}
         metosin/malli             {:mvn/version "0.20.0"}
         cheshire/cheshire         {:mvn/version "5.13.0"}
         com.walmartlabs/lacinia   {:mvn/version "1.2.2"}}
 :aliases
 {:run-m {:main-opts ["-m" "fylio.server"]}
  :run-x {:ns-default fylio.server
          :exec-fn    greet
          :exec-args  {:name "Clojure"}}
  :build {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
          :ns-default build}
  :test  {:extra-paths ["test"]
          :extra-deps  {org.clojure/test.check {:mvn/version "1.1.1"}
                        io.github.cognitect-labs/test-runner
                        {:git/tag "v0.5.1" :git/sha "dfb30dd"}}}}}
