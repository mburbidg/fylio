{:paths     ["src" "resources"]
 :deps      {org.clojure/clojure               {:mvn/version "1.12.0"}
             cheshire/cheshire                 {:mvn/version "5.13.0"}
             com.stuartsierra/component        {:mvn/version "1.2.0"}
             com.walmartlabs/lacinia           {:mvn/version "1.2.2"}
             com.walmartlabs/lacinia-pedestal  {:mvn/version "1.3.1"}
             com.github.seancorfield/next.jdbc {:mvn/version "1.3.1093"}
             org.postgresql/postgresql         {:mvn/version "42.7.10"}
             com.mchange/c3p0                  {:mvn/version "0.12.0"}
             io.aviso/logging                  {:mvn/version "1.0"}
             com.datomic/peer                  {:mvn/version "1.0.7491"}}
 :mvn/repos {"redplanetlabs" {:url "https://nexus.redplanetlabs.com/repository/maven-public-releases"}}
 :aliases
 {:run-m {:main-opts ["-m" "fylio.server"]}
  :run-x {:ns-default fylio.server
          :exec-fn    greet
          :exec-args  {:name "Clojure"}}
  :build {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
          :ns-default build}
  :dev   {:extra-paths ["dev-resources"]}
  :test  {:extra-paths ["test"]
          :extra-deps  {org.clojure/test.check {:mvn/version "1.1.1"}
                        io.github.cognitect-labs/test-runner
                        {:git/tag "v0.5.1" :git/sha "dfb30dd"}}}}}
